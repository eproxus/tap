% Tooling only: Mix builds the project (see mix.exs).
{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_lint, "6.0.0"}
]}.

{erlfmt, [
    write,
    {print_width, 80},
    {files, ["rebar.config", "src/**/*.{erl,app.src}"]}
]}.

{elvis, [
    {config, [
        #{files => ["src/*.erl"], ruleset => erl_files},
        #{files => ["rebar.config"], ruleset => rebar_config}
    ]}
]}.
